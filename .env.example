# Sao chép file này thành ".env.local" rồi điền 2 giá trị bên dưới.
# Lấy ở: Supabase Dashboard → Project Settings → API Keys (hoặc nút "Connect" trên cùng).
#
# Hai giá trị này là khoá CÔNG KHAI, an toàn khi nằm trong trình duyệt.
# TUYỆT ĐỐI không dán khoá "secret" / "service_role" vào đây.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
